# Скопіюй у ~/.config/tgbot.env і зроби chmod 600.
# Бот сам читає цей файл при старті (шлях можна змінити через TGBOT_ENV).

# --- обов'язкові ---
TG_TOKEN=123456:ABC...
TG_OWNER_ID=123456789

# --- опційні (значення за замовчуванням) ---
TMUX_SESSION=agents
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# кома-розділені підрядки pane_current_command, які вважаємо агентом.
# УВАГА: "node" пропускає і голий node REPL — звужуй, якщо Claude Code
# у тебе працює як окремий бінарник "claude".
AGENT_HINTS=claude,node
MAX_PROMPT_CHARS=8000
MAX_VOICE_SECONDS=600
WATCH_MAX_SECONDS=1800
WATCH_HEARTBEAT=180
PENDING_TTL=900
